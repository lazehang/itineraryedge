# Public Pages env only — never put Stripe secrets here.
# Copy to .env.local for local Next.js (gitignored).

# Core Worker A base URL (required for API calls)
NEXT_PUBLIC_CORE_WORKER_URL=http://127.0.0.1:8787

# Site origin for checkout return URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private Worker B base URL (omit if using mock unlock / standard PDF only)
# NEXT_PUBLIC_BILLING_WORKER_URL=https://itineraryedge-billing.example.workers.dev

# Show staging demo unlock UI — must match core ALLOW_MOCK_UNLOCK=1; never set on production
# NEXT_PUBLIC_ALLOW_MOCK_UNLOCK=1
