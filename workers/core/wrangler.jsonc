{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itineraryedge-core",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-29",
  "observability": {
    "enabled": true
  },
  // Replace database_id after `wrangler d1 create itineraryedge-global` in your account.
  // Optional vars for hosted AI (use `wrangler secret put BYOK_AI_KEY` — do not commit):
  // "vars": { "AI_PROVIDER": "openai" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "itineraryedge-global",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ]
}
