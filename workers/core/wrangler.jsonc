{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itineraryedge-core",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-29",
  "observability": {
    "enabled": true
  },
  // Replace database_id after `wrangler d1 create itineraryedge-global` in your account.
  // Optional vars (use `wrangler secret put BYOK_AI_KEY` for keys — do not commit):
  // "vars": {
  //   "AI_PROVIDER": "openai",
  //   "ALLOW_MOCK_UNLOCK": "1",
  //   "APP_ORIGIN": "https://your-pages-host.pages.dev",
  //   "ALLOWED_ORIGINS": "https://preview.example.com"
  // },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "itineraryedge-global",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ]
}
